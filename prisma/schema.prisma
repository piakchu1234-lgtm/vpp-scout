// SimplySite Production Schema
// "Scrape-Once, Store-Forever" Architecture
// Supports spatial data, market intelligence, AI insights, and acquisition pipeline

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// PROPERTY MODEL - Core Asset Intelligence Layer
// ==============================================================================

model Property {
  // PRIMARY IDENTIFIERS
  id        String   @id @default(cuid())
  pfi       String   @unique // Parcel Feature Identifier (Vicmap)
  spi       String?  @unique // Standard Parcel Identifier (Vicmap)

  // ADDRESS & LOCATION
  address   String   @db.VarChar(500)
  suburb    String   @db.VarChar(100)
  postcode  String   @db.VarChar(10)
  lga       String?  @db.VarChar(100) // Local Government Area

  // SPATIAL GEOMETRY (PostGIS-ready)
  longitude Decimal  @db.Decimal(10, 7)
  latitude  Decimal  @db.Decimal(10, 7)
  geometry  Json?    // GeoJSON Polygon (full boundary coordinates)

  // CADASTRAL ATTRIBUTES
  landSize  Float    // Square meters
  lotPlan   String?  @db.VarChar(50) // e.g., "LP123456"

  // PLANNING FRAMEWORK (Victoria Planning Provisions)
  zoning    String[] // Primary zone + schedules (e.g., ["GRZ1", "GRZ"])
  overlays  String[] // Planning overlays (e.g., ["HO123", "SBO", "ESO"])

  // MARKET INTELLIGENCE
  lastSoldPrice Int?     // AUD cents (e.g., 1350000 = $1.35M)
  lastSoldDate  DateTime? @db.Date
  bedrooms      Int?
  bathrooms     Int?
  carspaces     Int?
  yearBuilt     Int?
  wallMaterial  String?   @db.VarChar(100)
  roofMaterial  String?   @db.VarChar(100)

  // AI TOWN PLANNING INSIGHTS (Generated by Planning Agent)
  fastTrackEligible Boolean  @default(false)
  vppTier           String?  @db.VarChar(100) // e.g., "10-Day Fast Track"
  highestBestUse    String?  @db.Text // AI-generated development strategy
  riskFactors       String[] // Array of planning constraints
  estimatedYield    Int?     // Maximum dwelling yield

  // VPP COMPLIANCE SCORECARD (Deep Planning Analysis)
  complianceScorecard Json? // Stores ComplianceScorecard object

  // DATA FRESHNESS TRACKING
  lastScrapedAt DateTime @default(now())
  scrapedBy     String?  @db.VarChar(100) // Agent version/source

  // METADATA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONSHIPS
  pipelineCards PipelineCard[]

  // INDEXES
  @@index([pfi])
  @@index([suburb, postcode])
  @@index([lastScrapedAt])
  @@index([fastTrackEligible])
  @@map("properties")
}

// ==============================================================================
// PIPELINE CARD MODEL - Acquisition Kanban Board
// ==============================================================================

model PipelineCard {
  // PRIMARY IDENTIFIERS
  id         String   @id @default(cuid())
  propertyId String

  // KANBAN STAGE
  stage      PipelineStage @default(PROSPECT)

  // FINANCIAL FEASIBILITY
  purchasePrice         Int?    // AUD cents
  developmentCost       Int?    // AUD cents (construction + soft costs)
  grossRealizationValue Int?    // AUD cents (total sales revenue)
  developerMargin       Int?    // AUD cents (GRV - purchase - dev cost)
  marginPercentage      Float?  // Calculated: margin / GRV

  // USER ANNOTATIONS
  userNotes    String?  @db.Text
  tags         String[] // Custom tags for filtering

  // ASSIGNMENT & COLLABORATION
  assignedTo   String?  @db.VarChar(100) // User email/ID
  priority     Priority @default(MEDIUM)

  // TIMELINE TRACKING
  prospectDate DateTime? @db.Date
  loisentDate  DateTime? @db.Date
  ddCommenced  DateTime? @db.Date
  closedDate   DateTime? @db.Date

  // METADATA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RELATIONSHIPS
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // INDEXES
  @@index([propertyId])
  @@index([stage])
  @@index([assignedTo])
  @@map("pipeline_cards")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum PipelineStage {
  PROSPECT      // Initial research stage
  LOI_SENT      // Letter of Intent submitted
  DUE_DILIGENCE // Active due diligence
  CLOSED        // Deal completed
  PASSED        // Opportunity declined
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==============================================================================
// AGENT MARKET CACHE MODEL - Agentic Web Scraping Cache
// ==============================================================================

model AgentMarketCache {
  // PRIMARY IDENTIFIERS
  id      String @id @default(uuid())
  address String @unique @db.VarChar(500) // Normalized address for cache lookup

  // MARKET ATTRIBUTES (from agentic web search)
  bedrooms       Int?
  bathrooms      Int?
  estimatedValue Int? // AUD (stored as whole dollars, not cents)

  // METADATA
  source    String   @db.VarChar(50) // "agent" | "domain" | "mock"
  toolCalls Int      @default(1) // Number of LLM tool calls used

  // TIMESTAMPS (7-day TTL enforced at application level)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // INDEXES
  @@index([address])
  @@index([updatedAt])
  @@map("agent_market_cache")
}

// ==============================================================================
// MIGRATION NOTES
// ==============================================================================
// 1. PostGIS Extension: Run `CREATE EXTENSION IF NOT EXISTS postgis;` on database
// 2. Geometry Column: Consider native PostGIS geometry type for advanced spatial queries
// 3. Indexes: Add GiST index on geometry for spatial performance if using native PostGIS
// 4. Price Storage: Stored as cents (Int) to avoid floating-point precision issues

// ==============================================================================
// PROPERTY PARCEL MODEL - Reverse Search Engine (PostGIS-optimized)
// ==============================================================================

model PropertyParcel {
  // PRIMARY IDENTIFIERS
  id  String @id @default(cuid())
  pfi String @unique // Parcel Feature Identifier (Vicmap)

  // SPATIAL GEOMETRY (Native PostGIS)
  geometry Unsupported("geometry(Polygon, 4326)") // SRID 4326 = WGS84

  // CADASTRAL ATTRIBUTES
  lotArea    Float   // Square meters
  lotPlan    String? @db.VarChar(50)
  address    String  @db.VarChar(500)
  suburb     String  @db.VarChar(100)
  postcode   String  @db.VarChar(10)
  lga        String? @db.VarChar(100) // Local Government Area
  centroidX  Decimal @db.Decimal(10, 7) // Longitude (for quick lookups)
  centroidY  Decimal @db.Decimal(10, 7) // Latitude (for quick lookups)

  // PLANNING FRAMEWORK
  zoneCode      String   @db.VarChar(50) // Primary zone (e.g., "GRZ1")
  overlays      String[] // Planning overlays (e.g., ["HO123", "BMO"])
  hasHeritage   Boolean  @default(false) // Quick filter: Has Heritage Overlay
  hasBushfire   Boolean  @default(false) // Quick filter: Has Bushfire Management Overlay
  hasFlood      Boolean  @default(false) // Quick filter: Has Flood/Inundation Overlay

  // SITE FEASIBILITY (Pre-calculated for fast filtering)
  ssdEligible      Boolean @default(false) // ≥300m² + eligible zone + no restrictive overlays
  frontageEstimate Float? // Estimated street frontage in meters

  // DATA FRESHNESS
  lastUpdated DateTime @default(now())
  dataSource  String   @db.VarChar(50) // "vicmap" | "manual"

  // METADATA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // INDEXES
  @@index([zoneCode])
  @@index([suburb, postcode])
  @@index([lotArea])
  @@index([ssdEligible])
  @@index([hasHeritage])
  @@index([lastUpdated])
  @@map("property_parcels")
}

// ==============================================================================
// POSTGIS SETUP INSTRUCTIONS
// ==============================================================================
// 1. Enable PostGIS extension:
//    CREATE EXTENSION IF NOT EXISTS postgis;
//
// 2. Create spatial index (after migration):
//    CREATE INDEX property_parcels_geometry_idx ON property_parcels USING GIST (geometry);
//
// 3. Verify PostGIS installation:
//    SELECT PostGIS_version();
//
// 4. Example spatial query:
//    SELECT * FROM property_parcels
//    WHERE ST_Intersects(geometry, ST_MakeEnvelope(144.9, -37.9, 145.0, -37.8, 4326))
//    AND lot_area >= 600
//    AND zone_code = 'GRZ1';

