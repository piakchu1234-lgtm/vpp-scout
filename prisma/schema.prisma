// SimplySite Production Schema
// "Scrape-Once, Store-Forever" Architecture
// Supports spatial data, market intelligence, AI insights, and acquisition pipeline

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// PROPERTY MODEL - Core Asset Intelligence Layer
// ==============================================================================

model Property {
  // PRIMARY IDENTIFIERS
  id        String   @id @default(cuid())
  pfi       String   @unique // Parcel Feature Identifier (Vicmap)
  spi       String?  @unique // Standard Parcel Identifier (Vicmap)

  // ADDRESS & LOCATION
  address   String   @db.VarChar(500)
  suburb    String   @db.VarChar(100)
  postcode  String   @db.VarChar(10)
  lga       String?  @db.VarChar(100) // Local Government Area

  // SPATIAL GEOMETRY (PostGIS-ready)
  longitude Decimal  @db.Decimal(10, 7)
  latitude  Decimal  @db.Decimal(10, 7)
  geometry  Json?    // GeoJSON Polygon (full boundary coordinates)

  // CADASTRAL ATTRIBUTES
  landSize  Float    // Square meters
  lotPlan   String?  @db.VarChar(50) // e.g., "LP123456"

  // PLANNING FRAMEWORK (Victoria Planning Provisions)
  zoning    String[] // Primary zone + schedules (e.g., ["GRZ1", "GRZ"])
  overlays  String[] // Planning overlays (e.g., ["HO123", "SBO", "ESO"])

  // MARKET INTELLIGENCE
  lastSoldPrice Int?     // AUD cents (e.g., 1350000 = $1.35M)
  lastSoldDate  DateTime? @db.Date
  bedrooms      Int?
  bathrooms     Int?
  carspaces     Int?
  yearBuilt     Int?
  wallMaterial  String?   @db.VarChar(100)
  roofMaterial  String?   @db.VarChar(100)

  // AI TOWN PLANNING INSIGHTS (Generated by Planning Agent)
  fastTrackEligible Boolean  @default(false)
  vppTier           String?  @db.VarChar(100) // e.g., "10-Day Fast Track"
  highestBestUse    String?  @db.Text // AI-generated development strategy
  riskFactors       String[] // Array of planning constraints
  estimatedYield    Int?     // Maximum dwelling yield

  // VPP COMPLIANCE SCORECARD (Deep Planning Analysis)
  complianceScorecard Json? // Stores ComplianceScorecard object

  // DATA FRESHNESS TRACKING
  lastScrapedAt DateTime @default(now())
  scrapedBy     String?  @db.VarChar(100) // Agent version/source

  // METADATA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONSHIPS
  pipelineCards PipelineCard[]

  // INDEXES
  @@index([pfi])
  @@index([suburb, postcode])
  @@index([lastScrapedAt])
  @@index([fastTrackEligible])
  @@map("properties")
}

// ==============================================================================
// PIPELINE CARD MODEL - Acquisition Kanban Board
// ==============================================================================

model PipelineCard {
  // PRIMARY IDENTIFIERS
  id         String   @id @default(cuid())
  propertyId String

  // KANBAN STAGE
  stage      PipelineStage @default(PROSPECT)

  // FINANCIAL FEASIBILITY
  purchasePrice         Int?    // AUD cents
  developmentCost       Int?    // AUD cents (construction + soft costs)
  grossRealizationValue Int?    // AUD cents (total sales revenue)
  developerMargin       Int?    // AUD cents (GRV - purchase - dev cost)
  marginPercentage      Float?  // Calculated: margin / GRV

  // USER ANNOTATIONS
  userNotes    String?  @db.Text
  tags         String[] // Custom tags for filtering

  // ASSIGNMENT & COLLABORATION
  assignedTo   String?  @db.VarChar(100) // User email/ID
  priority     Priority @default(MEDIUM)

  // TIMELINE TRACKING
  prospectDate DateTime? @db.Date
  loisentDate  DateTime? @db.Date
  ddCommenced  DateTime? @db.Date
  closedDate   DateTime? @db.Date

  // METADATA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RELATIONSHIPS
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // INDEXES
  @@index([propertyId])
  @@index([stage])
  @@index([assignedTo])
  @@map("pipeline_cards")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum PipelineStage {
  PROSPECT      // Initial research stage
  LOI_SENT      // Letter of Intent submitted
  DUE_DILIGENCE // Active due diligence
  CLOSED        // Deal completed
  PASSED        // Opportunity declined
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==============================================================================
// MIGRATION NOTES
// ==============================================================================
// 1. PostGIS Extension: Run `CREATE EXTENSION IF NOT EXISTS postgis;` on database
// 2. Geometry Column: Consider native PostGIS geometry type for advanced spatial queries
// 3. Indexes: Add GiST index on geometry for spatial performance if using native PostGIS
// 4. Price Storage: Stored as cents (Int) to avoid floating-point precision issues
