// Prisma schema for the SimplySite property cache.
//
// DATABASE_URL is the Supabase pooled URL (port 6543) used by the
// runtime PrismaClient. DIRECT_URL is the non-pooled URL (port 5432)
// used by the Prisma CLI for `db push` / migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PropertyCache {
  // Normalized address (trim + lowercase) — matches lookup key in route.ts.
  address   String   @id
  // Full AIInsightData payload from the Gemini Auditor.
  aiData    Json
  // Auto-managed by Prisma; the 7-day cache window reads this.
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
