// Prisma schema for the SimplySite property cache.
//
// Prisma 7 note: datasource URLs are not declared here. The Prisma CLI
// reads its migration URL from prisma.config.ts; the runtime client in
// src/lib/prisma.ts passes a `pg` driver adapter to PrismaClient using
// process.env.DATABASE_URL (Supabase pooled, port 6543).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PropertyCache {
  // Normalized address (trim + lowercase) — matches lookup key in route.ts.
  address   String   @id
  // Full AIInsightData payload from the Gemini Auditor.
  aiData    Json
  // Auto-managed by Prisma; the 7-day cache window reads this.
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
