{
  // Wrangler configuration for the OpenNext-built Worker.
  //
  // `main` points at the bundle emitted by `opennextjs-cloudflare build`.
  // `nodejs_compat` is mandatory: Next.js 16's Proxy (formerly middleware)
  // runs on the Node.js runtime, and Clerk's `clerkMiddleware` plus the
  // Stripe SDK both rely on Node-API shims that the flag provides.
  //
  // `compatibility_date` is pinned to a recent Workers release that
  // supports the full `nodejs_compat` surface. Bump it as Cloudflare
  // ships new platform versions, but never lower than 2024-09-23 (the
  // first release with stable node:crypto support).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vpp-scout",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
